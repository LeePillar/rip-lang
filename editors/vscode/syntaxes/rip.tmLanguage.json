{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rip",
  "scopeName": "source.rip",
  "fileTypes": [
    "rp"
  ],
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#module-path" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.rip",
          "match": "//.*$"
        },
        {
          "name": "comment.block.rip",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.rip",
          "begin": "#\\[",
          "end": "\\]",
          "patterns": [
            { "include": "#strings" }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.rip",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.rip",
              "match": "\\\\\\$\\{"
            },
            {
              "name": "meta.interpolation.rip",
              "match": "\\$\\{[^}\\n]*\\}"
            },
            { "name": "constant.character.escape.rip", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.double.rip",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.rip", "match": "\\\\." }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.rip",
          "match": "'(\\\\.|[^'\\\\\\n])'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.rip",
          "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|(?:[0-9][0-9_]*)(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?)(?:[iu](?:8|16|32|64)|f64)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rip",
          "match": "\\b(?:if|elif|else|for|in|loop|while|match|break|continue|return|parallel|defer|async|await)\\b"
        },
        {
          "name": "keyword.other.rip",
          "match": "\\b(?:mod|use|as|pub|type|struct|obj|interface|enum|func|let|mut|const|static|self|read|write|share)\\b"
        },
        {
          "name": "constant.language.rip",
          "match": "\\b(?:true|false|null|ok|err|some|none)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.rip",
          "match": "\\b(?:int|i8|i16|i32|i64|u8|u16|u32|u64|float|string|bool|void|any|func)\\b"
        },
        {
          "name": "support.type.construct.rip",
          "match": "\\b(?:vec|map|option|result|task|share)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.rip",
          "match": "(?<=\\bfunc\\s+)[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)?(?=\\s*\\()"
        },
        {
          "name": "variable.function.call.rip",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "module-path": {
      "patterns": [
        {
          "name": "variable.other.module.rip",
          "match": "\\b(?:std|rust)(?:\\s*::\\s*[A-Za-z_][A-Za-z0-9_]*)+"
        },
        {
          "name": "punctuation.separator.namespace.rip",
          "match": "::"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.rip",
          "match": "->|=>|==|!=|<=|>=|&&|\\|\\||\\+|-|\\*|/|%|!|="
        },
        {
          "name": "keyword.operator.propagation.rip",
          "match": "\\?"
        }
      ]
    }
  }
}
