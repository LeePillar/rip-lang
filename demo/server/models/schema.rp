mod models;

use std::db;
use std::dev;
use std::time;

// 数据模型层：只负责表结构与数据访问，不依赖 http。

func id_definition(read driver: string) -> string {
    if driver == "mysql" {
        return "BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY";
    }
    if driver == "postgres" {
        return "BIGSERIAL PRIMARY KEY";
    }
    if driver == "mssql" {
        return "BIGINT IDENTITY(1,1) PRIMARY KEY";
    }
    return "INTEGER PRIMARY KEY AUTOINCREMENT";
}

func text_definition(read driver: string) -> string {
    if driver == "mssql" {
        return "NVARCHAR(255)";
    }
    if driver == "mysql" {
        return "VARCHAR(255)";
    }
    return "TEXT";
}

func schema_setup(read conn: db.conn) -> void {
    let driver: string = db.driver(conn);
    let idt: string = id_definition(driver);
    let txt: string = text_definition(driver);

    let mut users_sql: string = "CREATE TABLE IF NOT EXISTS users (id " + idt
        + ", name " + txt + " NOT NULL"
        + ", email " + txt + " NOT NULL UNIQUE"
        + ", phone " + txt + " NOT NULL DEFAULT ''"
        + ", password " + txt + " NOT NULL"
        + ", role " + txt + " NOT NULL DEFAULT 'user'"
        + ", status " + txt + " NOT NULL DEFAULT 'active'"
        + ", created_at " + txt + " NOT NULL"
        + ", updated_at " + txt + " NOT NULL)";
    let mut sessions_sql: string = "CREATE TABLE IF NOT EXISTS sessions (id " + idt
        + ", token " + txt + " NOT NULL UNIQUE"
        + ", user_id BIGINT NOT NULL"
        + ", expires_at BIGINT NOT NULL"
        + ", created_at " + txt + " NOT NULL)";

    // SQL Server 没有 CREATE TABLE IF NOT EXISTS，重复建表会报错，这里只建一次
    if driver == "mssql" {
        users_sql = users_sql.replace("CREATE TABLE IF NOT EXISTS", "CREATE TABLE");
        sessions_sql = sessions_sql.replace("CREATE TABLE IF NOT EXISTS", "CREATE TABLE");
    }

    match conn.execute(users_sql) {
        ok(count) => { }
        err(message) => { dev.log("schema users: " + message); }
    }
    match conn.execute(sessions_sql) {
        ok(count) => { }
        err(message) => { dev.log("schema sessions: " + message); }
    }
}

func schema_seed_admin(read conn: db.conn) -> void {
    match db.table(conn, "users").where("role", "=", "admin").count() {
        ok(count) => {
            if count > 0 {
                schema_upgrade_admin_password(conn);
                return;
            }
            let now: string = time.now().to_string();
            let values: map<string, any> = [
                "name" = "管理员",
                "email" = "admin@example.com",
                "phone" = "13800000000",
                "password" = hash_password("admin123"),
                "role" = "admin",
                "status" = "active",
                "created_at" = now,
                "updated_at" = now
            ];
            match user_store(conn, values) {
                ok(id) => { dev.log("seed admin: admin@example.com / admin123"); }
                err(message) => { dev.log("seed admin failed: " + message); }
            }
        }
        err(message) => { dev.log("seed admin check failed: " + message); }
    }
}

// 旧版本用的是自造弱哈希；检测到不是 ript 格式时，把已知的初始密码重新哈希。
func schema_upgrade_admin_password(read conn: db.conn) -> void {
    match user_find_by_email(conn, "admin@example.com") {
        ok(row) => {
            match row {
                some(admin) => {
                    let stored: string = admin.get("password").unwrap_or("").as_string().unwrap_or("");
                    if stored.starts_with("ript$") {
                        return;
                    }
                    let id: int = admin.get("id").unwrap_or(0).as_int().unwrap_or(0);
                    let mut changes: map<string, any> = [];
                    changes.set("password", hash_password("admin123"));
                    match user_patch(conn, id, changes) {
                        ok(count) => { dev.log("upgrade admin password to std/crypto hash"); }
                        err(message) => { dev.log("upgrade admin password failed: " + message); }
                    }
                }
                none => { }
            }
        }
        err(message) => { dev.log("upgrade admin password skipped: " + message); }
    }
}
